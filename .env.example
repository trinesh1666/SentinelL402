# SentinelL402 environment configuration

# Application
APP_ENV=development

# CORS
# Comma-separated frontend origins.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# Lightning / Nostr Wallet Connect
# NEVER put real wallet credentials in this file.
NWC_CONNECTION_STRING=YOUR_RECEIVER_WALLET_NWC_CONNECTION
TEST_PAYER_NWC_CONNECTION_STRING=YOUR_TEST_PAYER_NWC_CONNECTION